def sudoku() {
    int grid[81];
    int fixed[81];
    int curr;
    int dir;
    int iter;
    int found;
    int r;
    int c;
    int v;
    int valid;
    int i;
    int j;
    int br;
    int bc;
    int check_idx;
    
    for(i = 0; i < 81; i = i + 1) {
        grid[i] = 0;
        fixed[i] = 0;
    }
    
    grid[0] = 5;
    fixed[0] = 1;
    grid[1] = 3;
    fixed[1] = 1;
    grid[4] = 7;
    fixed[4] = 1;
    grid[9] = 6;
    fixed[9] = 1;
    grid[12] = 1;
    fixed[12] = 1;
    grid[13] = 9;
    fixed[13] = 1;
    grid[14] = 5;
    fixed[14] = 1;
    grid[21] = 9;
    fixed[21] = 1;
    grid[22] = 8;
    fixed[22] = 1;
    grid[27] = 8;
    fixed[27] = 1;
    grid[31] = 6;
    fixed[31] = 1;
    grid[35] = 3;
    fixed[35] = 1;
    grid[36] = 4;
    fixed[36] = 1;
    grid[39] = 8;
    fixed[39] = 1;
    grid[41] = 3;
    fixed[41] = 1;
    grid[44] = 1;
    fixed[44] = 1;
    grid[45] = 7;
    fixed[45] = 1;
    grid[49] = 2;
    fixed[49] = 1;
    grid[53] = 6;
    fixed[53] = 1;
    grid[58] = 6;
    fixed[58] = 1;
    grid[61] = 2;
    fixed[61] = 1;
    grid[62] = 8;
    fixed[62] = 1;
    grid[66] = 4;
    fixed[66] = 1;
    grid[67] = 1;
    fixed[67] = 1;
    grid[68] = 9;
    fixed[68] = 1;
    grid[71] = 5;
    fixed[71] = 1;
    grid[76] = 8;
    fixed[76] = 1;
    grid[79] = 7;
    fixed[79] = 1;
    grid[80] = 9;
    fixed[80] = 1;
    
    curr = 0;
    dir = 1;
    found = 0;
    
    for(iter = 0; iter < 90000; iter = iter + 1) {
        if(found == 0) {
            if(curr == 81) {
                found = 1;
            } else {
                if(curr < 0) {
                    found = 2;
                } else {
                    if(fixed[curr] == 1) {
                        curr = curr + dir;
                    } else {
                        grid[curr] = grid[curr] + 1;
                        if(grid[curr] > 9) {
                            grid[curr] = 0;
                            dir = 0 - 1;
                            curr = curr - 1;
                        } else {
                            valid = 1;
                            v = grid[curr];
                            r = curr / 9;
                            c = curr % 9;
                            
                            for(i = 0; i < 9; i = i + 1) {
                                check_idx = r * 9 + i;
                                if(check_idx != curr) {
                                    if(grid[check_idx] == v) {
                                        valid = 0;
                                    }
                                }
                            }
                            
                            for(i = 0; i < 9; i = i + 1) {
                                check_idx = i * 9 + c;
                                if(check_idx != curr) {
                                    if(grid[check_idx] == v) {
                                        valid = 0;
                                    }
                                }
                            }
                            
                            br = r / 3;
                            br = br * 3;
                            bc = c / 3;
                            bc = bc * 3;
                            
                            for(i = 0; i < 3; i = i + 1) {
                                for(j = 0; j < 3; j = j + 1) {
                                    check_idx = (br + i) * 9 + (bc + j);
                                    if(check_idx != curr) {
                                        if(grid[check_idx] == v) {
                                            valid = 0;
                                        }
                                    }
                                }
                            }
                            
                            if(valid == 1) {
                                dir = 1;
                                curr = curr + 1;
                            } else {
                                dir = 0;
                            }
                        }
                    }
                }
            }
        }
    }
    
    if(found == 1) {
        print 9999;
        for(i = 0; i < 81; i = i + 1) {
            print grid[i];
        }
    } else {
        print 0;
    }
    
    return;
}

def principal() {
    int iniciar;
    iniciar = sudoku();
    return;
}